    "version": "0.2.0",
    "configurations": [
        {
            "name": "MAST unit",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/src",
            // "jinja": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
        },
        {
            "name": "Test phd2",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
        }
    ]
}